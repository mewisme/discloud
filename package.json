{
  "name": "discloud",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "web:dev": "pnpm --filter @discloud/web dev",
    "web:build": "pnpm --filter @discloud/web build",
    "web:lint": "pnpm --filter @discloud/web lint",
    "web:lint:fix": "pnpm --filter @discloud/web lint:fix",
    "web:typecheck": "pnpm --filter @discloud/web typecheck",
    "web:test": "pnpm --filter @discloud/web test",
    "desktop:dev": "pnpm --filter @discloud/desktop dev",
    "desktop:build": "pnpm --filter @discloud/desktop build",
    "desktop:lint": "pnpm --filter @discloud/desktop lint",
    "desktop:lint:fix": "pnpm --filter @discloud/desktop lint:fix",
    "desktop:typecheck": "pnpm --filter @discloud/desktop typecheck",
    "desktop:tauri": "pnpm --filter @discloud/desktop tauri",
    "api:types": "pnpm --filter @discloud/api api:types",
    "api:types:check": "pnpm --filter @discloud/api api:types:check",
    "api:typecheck": "pnpm --filter @discloud/api typecheck",
    "app-ui:typecheck": "pnpm --filter @discloud/app-ui typecheck",
    "shared:typecheck": "pnpm --filter @discloud/shared typecheck",
    "ui:typecheck": "pnpm --filter @discloud/ui typecheck"
  }
}