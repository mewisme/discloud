# HTTP
DISCLOUD_HTTP_LISTEN_ADDRESS=:8080
DISCLOUD_PUBLIC_BASE_URL=http://localhost:8080
DISCLOUD_HTTP_READ_HEADER_TIMEOUT=5s
DISCLOUD_HTTP_IDLE_TIMEOUT=2m
DISCLOUD_HTTP_SHUTDOWN_TIMEOUT=15s
DISCLOUD_HTTP_MAX_HEADER_BYTES=1048576
DISCLOUD_HTTP_TRUSTED_PROXIES=
DISCLOUD_HTTP_CORS_ALLOWED_ORIGINS=

# PostgreSQL
DISCLOUD_DATABASE_DSN=postgres://discloud:discloud@localhost:5432/discloud?sslmode=disable
DISCLOUD_DATABASE_MIN_CONNECTIONS=0
DISCLOUD_DATABASE_MAX_CONNECTIONS=10
DISCLOUD_DATABASE_MAX_CONNECTION_LIFE=1h
DISCLOUD_DATABASE_MAX_CONNECTION_IDLE=30m
DISCLOUD_DATABASE_HEALTH_CHECK_PERIOD=1m

# Authentication
DISCLOUD_AUTH_SESSION_TTL=720h
DISCLOUD_AUTH_COOKIE_NAME=discloud_session
DISCLOUD_AUTH_COOKIE_DOMAIN=
DISCLOUD_AUTH_COOKIE_PATH=/
DISCLOUD_AUTH_COOKIE_SECURE=false
DISCLOUD_AUTH_COOKIE_SAME_SITE=lax

# MFA
DISCLOUD_MFA_ISSUER=DisCloud

# Base64-encoded application encryption master key.
# Semantic key-length validation is implemented in Step 0.4.
DISCLOUD_ENCRYPTION_MASTER_KEY_BASE64=

# Discord
DISCLOUD_DISCORD_GUILD_ID=
DISCLOUD_DISCORD_CHANNEL_ID=

# Tokens are equal peers.
# Their configured order becomes the initial round-robin order.
# Separate tokens with commas.
DISCLOUD_DISCORD_BOT_TOKENS=

DISCLOUD_DISCORD_MAX_CONCURRENT_UPLOADS=8
DISCLOUD_DISCORD_MAX_CONCURRENT_DOWNLOADS=8

# Upload
# Accepted syntax:
#   raw bytes
#   B
#   KiB
#   MiB
#
# Default: 10 MiB
# Maximum: 20 MiB (validated in Step 0.4)
DISCLOUD_UPLOAD_CHUNK_SIZE=10MiB
DISCLOUD_UPLOAD_SESSION_TTL=48h

# Background jobs
DISCLOUD_JOBS_WORKER_COUNT=4

# Logging
DISCLOUD_LOG_LEVEL=info