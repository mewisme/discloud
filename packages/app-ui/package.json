{
  "name": "@discloud/app-ui",
  "version": "0.1.1-beta.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./activity/*": "./src/activity/ui/*.tsx",
    "./admin/*": "./src/admin/ui/*.tsx",
    "./auth/*": "./src/auth/ui/*.tsx",
    "./collections/*": "./src/collections/ui/*.tsx",
    "./favorites/*": "./src/favorites/ui/*.tsx",
    "./files/file-browser": "./src/files/core/file-browser.ts",
    "./files/*": "./src/files/ui/*.tsx",
    "./search/*": "./src/search/ui/*.tsx",
    "./shares/*": "./src/shares/ui/*.tsx",
    "./shared/*": "./src/shared/ui/*.tsx",
    "./settings/*": "./src/settings/ui/*.tsx",
    "./shell/navigation": "./src/shell/core/navigation.ts",
    "./shell/*": "./src/shell/ui/*.tsx",
    "./storage/*": "./src/storage/ui/*.tsx",
    "./trash/*": "./src/trash/ui/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discloud/api": "workspace:*",
    "@discloud/shared": "workspace:*",
    "@discloud/ui": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
